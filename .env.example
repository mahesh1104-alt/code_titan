# App URL
NEXT_PUBLIC_SITE_URL=https://brandguard.vercel.app

# Demo Mode & Seeding
NEXT_PUBLIC_DEMO_MODE=true
DEMO_PASSWORD=technova_demo_2026

# Supabase Auth, DB & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Google Gemini / Vercel AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
AI_MODEL_FAST=gemini-1.5-flash
AI_MODEL_REASONING=gemini-1.5-pro
AI_EMBEDDING_MODEL=text-embedding-004

# Stripe Subscriptions (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# Rate Limiting & Queue
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Email & Notifications
RESEND_API_KEY=re_...
